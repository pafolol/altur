# THE project .env. Copy to .env (git-ignored) and fill in what you need.
#
#   copy .env.example .env
#
# One file, read by all three services, each with its own loader and no dependency:
#
#   python src/server.py            config.py                -> the fusion server, the pages, /api/*
#   uvicorn server:app   (semantic/) semantic/config.py       -> the semantic verifier
#   uvicorn app.main:app (backend/)  backend/app/config.py    -> the serving shell
#
# A real environment variable always beats this file, so a single run can still override one:
#
#   set SEMANTIC_URL=http://other:9000/detect && python src/server.py
#
# A service-local .env (semantic/.env, backend/.env) still wins over this one if you ever want to keep
# a service's configuration separate. Everything here is optional - with no .env at all the fusion
# server runs, the semantic verifier reports itself unavailable, and the live-call panel says what is
# missing.

# ----------------------------------------------------------------- the semantic verifier
# Its two paid APIs. The service refuses to start without both; the fusion just marks the layer
# unavailable and hands its 15 % to the other two.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GOOGLE_PROJECT_NUMBER=

# Where the fusion looks for that service. Port 8100 rather than its own default 8000, so it does not
# collide with the fusion server. Unset = the layer abstains; nothing waits for it.
SEMANTIC_URL=http://127.0.0.1:8100/detect
SEMANTIC_TIMEOUT_S=30

# ----------------------------------------------------------------- the live-call demo (console panel 03)
# Only needed for "Call and analyse". From the Twilio console; the auth token is a secret.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the call is placed FROM, in E.164.
TWILIO_PHONE_NUMBER=
# Optional default destination, so the panel and `python src/twilio_demo.py` run with no argument.
TWILIO_TO_NUMBER=

# ----------------------------------------------------------------- the backend serving shell
# fusion -> answers with src/fusion.py (what you want). mock -> flags EVERY caller synthetic. model ->
# its own joblib bundle. See backend/INTEGRATION.md.
DETECTOR_MODE=fusion
ACOUSTIC_MODEL=wav2vec2_spanish
MODEL_THRESHOLD=0.5
ENABLE_DEBUG_ENDPOINT=false
MAX_REQUEST_SIZE_MB=20
MAX_AUDIO_DURATION_SECONDS=300
MIN_AUDIO_DURATION_SECONDS=0.25
MIN_CALLER_SPEECH_SECONDS=0.10
LOG_LEVEL=INFO
