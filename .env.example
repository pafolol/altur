# Copy to .env (git-ignored) for the FUSION SERVER: python src/server.py
#
# Everything here is optional. With none of it set the server still runs: /detect answers with the
# acoustic and behaviour layers, the semantic verifier reports itself unavailable, and the live-call
# panel replaces itself with a note saying which variables are missing.
#
# A real environment variable always wins over this file, so you can still override one for a single
# run:  set SEMANTIC_URL=... && python src/server.py
#
# The other two services read their OWN files, not this one:
#   semantic/.env    ELEVENLABS_API_KEY, GEMINI_API_KEY   (see semantic/.env.example)
#   backend/.env     served with: uvicorn app.main:app --env-file .env   (see backend/.env.example)

# ----------------------------------------------------------------- the semantic verifier
# Where the semantic service is listening. Unset = the layer abstains and its 15 % goes to the other
# two; nothing waits for it. Port 8100 rather than its own default 8000, so it does not collide.
SEMANTIC_URL=http://127.0.0.1:8100/detect
# How long to wait for it before giving up on a call (seconds).
SEMANTIC_TIMEOUT_S=30

# ----------------------------------------------------------------- the live-call demo (panel 03)
# Only needed for "Call and analyse". Get these from the Twilio console; the auth token is a secret,
# so keep this file out of Git - it already is.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the call is placed FROM, in E.164.
TWILIO_PHONE_NUMBER=
# Optional: a default destination, so the panel and `python src/twilio_demo.py` can be run with no
# argument. The panel's input box overrides it.
TWILIO_TO_NUMBER=
