# THE project .env. Copy to .env (git-ignored) and fill in what you need.
#
#   copy .env.example .env
#
# One file, read by the single backend and its in-process modules with no loader dependency:
#
#   python src/server.py            -> detection, semantic, demo, Twilio, admin and pages
#
# A semantic/.env still wins if you want to keep those credentials separate. Everything here is optional:
# without keys the server runs, semantic reports itself unavailable, and the live-call panel says what is
# missing.

# ----------------------------------------------------------------- the semantic verifier
# Its two paid APIs. Without both, fusion marks the layer unavailable and hands its 15 % to the others.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GOOGLE_PROJECT_NUMBER=

# ----------------------------------------------------------------- the live call ("Try being the caller")
# Only needed for the live-call button on /demo/ and panel 03 of the console. From the Twilio console;
# the auth token is a secret.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the call is placed FROM, in E.164.
TWILIO_PHONE_NUMBER=
# The number it calls TO. The demo's one button sends NO destination, so this is the only thing that says
# whose phone rings; `python src/twilio_demo.py` with no argument uses it too. Without it that button
# disables itself and names this variable.
TWILIO_TO_NUMBER=

# ----------------------------------------------------------------- the web app (web/)
# Where the landing's admin panel and the latency demo look for the fusion server. Only VITE_-prefixed
# variables reach the browser, so nothing else in this file is ever bundled.
#   unset    -> /admin/ falls back to its seeded mock and the pill reads SAMPLE; /demo/ says it needs this
#   set      -> both talk to the real server and the pill reads LIVE
# 127.0.0.1 rather than localhost: uvicorn binds IPv4 only, and on Windows localhost resolves to ::1
# first, which costs a timeout on every request.
VITE_API_URL=http://127.0.0.1:8000

# ----------------------------------------------------------------- the Tiger telemetry service (tiger-telemetry/)
# The one optional second process: a small FastAPI service that keeps a copy of every verdict in Tiger Data
# (PostgreSQL / TimescaleDB). The backend mirrors each decision to it right after its own SQLite call log;
# leave TELEMETRY_URL empty and nothing is sent. Run it from the repository root so it reads this file:
#   tiger-telemetry/.venv/bin/uvicorn --app-dir tiger-telemetry --env-file .env app.main:app --port 8200
TELEMETRY_URL=http://127.0.0.1:8200
# Its database. Tiger Cloud: the URI from the service's Connect panel (postgresql://...?sslmode=require).
# A local Postgres works too: run the CREATE TABLE of tiger-telemetry/schema.sql against it.
TIGER_DATABASE_URL=
# Browsers allowed to read its /detections and /stats directly.
TELEMETRY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ----------------------------------------------------------------- backend/, the superseded second shell
# NOT read by `python src/server.py`, which is the backend. These configure `backend/`, the alternative
# serving shell kept from the backend-esteban merge - nothing runs it; see backend/INTEGRATION.md. Left
# here so that shell still starts if anyone checks it out, and harmless otherwise.
# fusion -> answers with src/fusion.py. mock -> flags EVERY caller synthetic. model -> its own joblib.
DETECTOR_MODE=fusion
ACOUSTIC_MODEL=wav2vec2_spanish
MODEL_THRESHOLD=0.5
ENABLE_DEBUG_ENDPOINT=false
MAX_REQUEST_SIZE_MB=20
MAX_AUDIO_DURATION_SECONDS=300
MIN_AUDIO_DURATION_SECONDS=0.25
MIN_CALLER_SPEECH_SECONDS=0.10
LOG_LEVEL=INFO
