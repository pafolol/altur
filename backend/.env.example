# mock   -> 0.5 for every call, which at threshold 0.5 flags EVERY caller synthetic. Never ship it.
# model  -> this backend's own joblib bundle over its own features (MODEL_PATH).
# fusion -> the repository's real detector, src/fusion.py. This is the one that works.
DETECTOR_MODE=fusion
MODEL_PATH=models/detector.joblib
MODEL_THRESHOLD=0.5
ENABLE_DEBUG_ENDPOINT=true
MAX_AUDIO_DURATION_SECONDS=300
MAX_REQUEST_SIZE_MB=20
PORT=8000
LOG_LEVEL=INFO
# FUSION_MODE / FUSION_WEIGHTS / FUSION_MODEL_PATH apply to app/fusion.py, this backend's own
# placeholder combiner. DETECTOR_MODE=fusion bypasses all three: the weights, the roles and the
# verifier gate live in src/fusion.py, so there is only ever one place that decides.
FUSION_MODE=single_model
FUSION_WEIGHTS=behavior=1,acoustic=1,semantic=1
FUSION_MODEL_PATH=models/fusion_model.joblib

# Used only when DETECTOR_MODE=fusion.
ACOUSTIC_MODEL=wav2vec2_spanish
# Unset is fine: the semantic verifier then reports itself unavailable and its share goes to the
# other two layers. Nothing waits for it.
SEMANTIC_URL=
MIN_AUDIO_DURATION_SECONDS=0.25
MIN_CALLER_SPEECH_SECONDS=0.10
ENABLE_PITCH_FEATURES=true
ENABLE_FEATURE_WARMUP=true
